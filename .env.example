# Copy to .env and fill in. Never commit .env.
# Generate a secret:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- 공개 주소 (선택) --------------------------------------------------------------
# 이 서버가 바깥에서 보이는 주소. start-online.cmd 가 안내 문구로만 씁니다 (코드는 이 값에 의존하지 않음).
# 터널 주소가 바뀌어도 여기만 고치세요.
# PUBLIC_URL=https://api.example.com

# 어떤 터널을 쓸지: ngrok(기본) 또는 cloudflared  (npm run tunnel 이 읽습니다)
# TUNNEL=ngrok
# Cloudflare 고정 터널 토큰 (비밀! 커밋 금지). 비어 있으면 cloudflared 는 임시 주소로 실행됩니다.
# CLOUDFLARE_TUNNEL_TOKEN=

# Network
PORT=8787
# 127.0.0.1 = local only. Use 0.0.0.0 inside Docker, and put a TLS reverse proxy in front.
HOST=127.0.0.1

# Where admin.sqlite and per-project data live. Default: <repo>/data
# DATA_DIR=./data

# Bearer token for the /admin API (min 32 chars). Grants full control of every project.
ADMIN_TOKEN=

# Master secret from which every project's API-key signing secret is derived (min 32 chars).
# Must differ from ADMIN_TOKEN. Changing it invalidates ALL issued API keys.
JWT_MASTER_SECRET=

# Browsers allowed to call the data APIs (not /admin): comma-separated origins, or *.
# Empty = CORS disabled (same-origin only).
CORS_ORIGINS=

# Pages allowed to call the ADMIN API from another origin, e.g. a dashboard hosted on GitHub Pages.
# Exact origins only (no *, no path), comma-separated. Empty = the admin API answers only to its own dashboard.
# Those pages log in with ADMIN_TOKEN and can do everything: list only sites you control.
# ADMIN_CORS_ORIGINS=https://your-name.github.io

# /admin 과 /dashboard 에 접근할 수 있는 IP (쉼표로 구분, 단일 IP 만). 목록에 없으면 404.
# 비워 두면 제한 없음. 프록시/터널 뒤에서는 반드시 TRUST_PROXY_HOPS 도 맞춰야 진짜 접속자 IP 로 판단합니다.
# 내 PC 에서 직접 열 때(주소가 127.0.0.1)도 쓰려면 127.0.0.1 을 같이 넣으세요.
# ADMIN_ALLOWED_IPS=203.0.113.10,127.0.0.1

# false 로 하면 누구도 새로 가입할 수 없습니다 (이미 있는 사용자는 로그인 가능). 기본 true.
# SIGNUP_ENABLED=true

# 백업: npm run backup:rotate 가 남길 개수 (기본 7)
# BACKUP_KEEP=7

# Max JSON request body in bytes (default 1 MiB)
# MAX_JSON_BYTES=1048576

# How many reverse proxies sit in front of this server (Caddy, nginx, cloudflared, ...).
# 0 = use the socket address. Wrong values let clients spoof their IP and dodge rate limits.
# TRUST_PROXY_HOPS=0

# File storage limits (bytes). Without quotas anyone who can sign up could fill the disk.
# MAX_UPLOAD_BYTES=52428800              # one file, 50 MiB
# STORAGE_USER_QUOTA_BYTES=104857600     # per signed-in user and project, 100 MiB (service_role exempt)
# STORAGE_PROJECT_QUOTA_BYTES=2147483648 # per project, 2 GiB

# Realtime (WebSocket at /realtime): simultaneous connections the server accepts
# REALTIME_MAX_CONNECTIONS=500

# User sessions: access token lifetime and refresh token lifetime
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
